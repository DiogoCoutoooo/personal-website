---
import Layout from '../../../layouts/Layout.astro';
import midiaData from '../../../data/midia.json';
---

<Layout title="Leitor — Coluna de Harmonia, Madrugada em Clave" description="Leia uma amostra do livro Coluna de Harmonia, Madrugada em Clave.">
    <div class="reader-container">
        <!-- Floating Exit Fullscreen Button (Always accessible in fullscreen) -->
        <button id="btn-floating-exit-fs" class="floating-exit-fs" title="Sair do Ecrã Inteiro" aria-label="Sair do Ecrã Inteiro">
            <svg viewBox="0 0 24 24"><path d="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"/></svg>
        </button>

        <!-- Header Controls -->
        <header class="reader-header">
            <div class="header-left">
                <a href="/obras/MeC_CdH" class="back-link">
                    <span class="icon">✕</span>
                    <span class="text">Sair do Leitor</span>
                </a>
            </div>
            <div class="header-center">
                <h1 class="book-title-mini">Coluna de Harmonia, Madrugada em Clave</h1>
            </div>
            <div id="btn-fullscreen-header" class="header-right header-fullscreen-btn">
                 <button class="footer-btn" title="Ecrã Inteiro" aria-label="Ecrã Inteiro">
                    <svg class="icon-enter-fs" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                    <svg class="icon-exit-fs" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"/></svg>
                </button>
            </div>
            <div class="header-right page-counter-container">
                <span id="page-counter">A carregar...</span>
            </div>
        </header>

        <!-- Main Reader Shell -->
        <div class="reader-shell">
            <button id="btn-prev" class="nav-btn prev" aria-label="Página Anterior">
                <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
            </button>
            
            <div class="book-bounds">
                <div id="book-canvas-container" class="book-canvas-container">
                    <div id="book" class="book">
                        <!-- Pages will be injected here -->
                    </div>
                </div>
            </div>

            <button id="btn-next" class="nav-btn next" aria-label="Próxima Página">
                <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
            </button>
        </div>

        <!-- Footer Controls -->
        <footer class="reader-footer">
            <div class="footer-controls">
                <div class="page-slider-container">
                    <input type="number" id="page-input" class="page-input" value="0" min="0" max="605" aria-label="Ir para página">
                    <div class="slider-wrapper">
                        <input type="range" id="page-slider" min="0" max="605" value="0" step="1">
                        <div id="slider-tooltip" class="slider-tooltip hidden">0</div>
                    </div>
                    <span id="slider-total-label" class="slider-label">605</span>
                </div>
                <div class="footer-right">
                    <button id="btn-fullscreen" class="footer-btn" title="Ecrã Inteiro" aria-label="Ecrã Inteiro">
                        <svg class="icon-enter-fs" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                        <svg class="icon-exit-fs" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"/></svg>
                    </button>
                </div>
            </div>
        </footer>

        <!-- Loading Overlay -->
        <div id="loading-overlay" class="loading-overlay">
            <div class="loader"></div>
            <p>A preparar a sua leitura...</p>
        </div>

        <!-- Player Modal -->
        <div id="playerModal" class="player-modal hidden">
            <div class="modal-overlay"></div>
            
            <div class="modal-content">
                <button class="minimize-modal" aria-label="Minimizar/Maximizar">
                    <svg class="icon-min" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <svg class="icon-max" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
                </button>
                <button class="close-modal" aria-label="Fechar">&times;</button>
                <div id="playerContainer" class="player-container">
                    <!-- Player or Album List will be injected here -->
                </div>
                <div id="dragOverlay" class="drag-overlay"></div>
                <div class="modal-info">
                    <div class="modal-header-info">
                        <span id="modalNumber"></span>
                        <h2 id="modalTitle"></h2>
                    </div>
                    <div id="albumTrackList" class="album-track-list hidden">
                        <!-- Track list for albums -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script is:inline define:vars={{ midiaData }}>
    window.MIDIA_DATA = midiaData;
</script>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>
<script is:inline src="https://unpkg.com/page-flip/dist/js/page-flip.browser.js"></script>

<script is:inline>
    // Configuration
    const PDF_PATH = 'https://media.antonioabrantes.com/MAD_CH_6023-25_LIVRO_AS_Tamanho_Envelope%20C5_TRABALHO_PC_Final%20.pdf';
    let pdfDoc = null;
    let pageFlip = null;
    
    const loadingOverlay = document.getElementById('loading-overlay');
    const bookContainer = document.getElementById('book');
    const pageCounter = document.getElementById('page-counter');
    const pageSlider = document.getElementById('page-slider');
    const pageInput = document.getElementById('page-input');
    const sliderTooltip = document.getElementById('slider-tooltip');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const btnFullscreen = document.getElementById('btn-fullscreen');

    // Initialize PDF.js
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';

    async function initReader() {
        try {
            // Load PDF
            pdfDoc = await pdfjsLib.getDocument(PDF_PATH).promise;
            const totalPages = pdfDoc.numPages;
            const maxPage = totalPages - 1;
            
            pageSlider.min = 0;
            pageSlider.max = maxPage;
            pageInput.min = 0;
            pageInput.max = maxPage;
            
            // We need to determine the aspect ratio from the first page
            const firstPage = await pdfDoc.getPage(1);
            const vp = firstPage.getViewport({ scale: 1 });
            const pageAspectRatio = vp.width / vp.height;
            const baseHeight = 800;
            const baseWidth = baseHeight * pageAspectRatio;

            function isMobileOrTablet() {
                const ua = navigator.userAgent || '';
                const isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
                const isMobileUA = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(ua);
                const isSmallOrTabletScreen = window.innerWidth <= 1024;
                return isMobileUA || (isTouch && isSmallOrTabletScreen) || isSmallOrTabletScreen;
            }

            // Check URL parameters for page and media
            const urlParams = new URLSearchParams(window.location.search);
            const pageParam = urlParams.get('p');
            const mediaParam = urlParams.get('m');
            const timeParam = urlParams.get('t');
            const trackParam = urlParams.get('tr');

            let initialPage = 0;
            if (pageParam) {
                const parsed = parseInt(pageParam);
                if (!isNaN(parsed) && parsed >= 0 && parsed <= maxPage) {
                    initialPage = parsed;
                }
            }

            pageFlip = new St.PageFlip(bookContainer, {
                width: baseWidth,
                height: baseHeight,
                size: "stretch",
                minWidth: 100,
                maxWidth: 2000,
                minHeight: 100,
                maxHeight: 2000,
                maxShadowOpacity: 0.5,
                showCover: true,
                mobileScrollSupport: false,
                useMouseEvents: true
            });

            // Create page placeholders (0 to maxPage)
            for (let i = 0; i < totalPages; i++) {
                const pageEl = document.createElement('div');
                pageEl.className = 'page';
                pageEl.innerHTML = `
                    <div class="page-content">
                        <canvas id="canvas-page-${i}"></canvas>
                    </div>
                `;
                bookContainer.appendChild(pageEl);
            }

            pageFlip.loadFromHTML(document.querySelectorAll('.page'));
            document.getElementById('slider-total-label').textContent = maxPage;

            // Customize bounds calculation so that mobile/tablets maximize ONE page
            const render = pageFlip.getRender();
            if (render) {
                render.calculateBoundsRect = function() {
                    let t = "landscape";
                    const e = this.getBlockWidth();
                    const i = e / 2;
                    const s = this.getBlockHeight() / 2;
                    const n = this.setting.width / this.setting.height;
                    let h = this.setting.width;
                    let r = this.setting.height;
                    let o = i - h;

                    const container = document.querySelector('.reader-container');
                    const isFullscreen = container && (container.classList.contains('is-fullscreen') || container.classList.contains('pseudo-fullscreen'));
                    const mobileOrTablet = isMobileOrTablet();
                    const isPortraitScreen = window.innerHeight > window.innerWidth;

                    // Maximize single page on mobile/tablets, portrait screens, or narrow containers
                    if (mobileOrTablet || (isFullscreen && window.innerWidth < 1200) || isPortraitScreen || e < s * 1.8 * n) {
                        if (this.app.getSettings().usePortrait) {
                            t = "portrait";
                        }
                    }

                    if ("stretch" === this.setting.size) {
                        h = ("portrait" === t) ? this.getBlockWidth() : (this.getBlockWidth() / 2);
                        if (h > this.setting.maxWidth) h = this.setting.maxWidth;
                        r = h / n;
                        if (r > this.getBlockHeight()) {
                            r = this.getBlockHeight();
                            h = r * n;
                        }
                        o = ("portrait" === t) ? (i - h / 2 - h) : (i - h);
                    } else {
                        if (e < 2 * h && this.app.getSettings().usePortrait) {
                            t = "portrait";
                            o = i - h / 2 - h;
                        }
                    }

                    this.boundsRect = {
                        left: o,
                        top: s - r / 2,
                        width: 2 * h,
                        height: r,
                        pageWidth: h
                    };
                    return t;
                };
                pageFlip.update();
            }

            function preload(current) {
                for (let i = current - 4; i <= current + 4; i++) {
                    renderPage(i);
                }
            }

            // Events
            btnPrev.addEventListener('click', () => pageFlip.flipPrev());
            btnNext.addEventListener('click', () => pageFlip.flipNext());

            pageFlip.on('changeState', (e) => {
                if (e.data === 'user_fold') {
                    const currentPage = pageFlip.getCurrentPageIndex();
                    preload(currentPage);
                }
            });

            pageFlip.on('flip', (e) => {
                const currentPage = e.data;
                updateUI(currentPage);
                preload(currentPage);
            });

            pageSlider.addEventListener('input', (e) => {
                const pageNum = parseInt(e.target.value);
                // Show tooltip while dragging - don't navigate yet
                sliderTooltip.textContent = pageNum;
                sliderTooltip.classList.remove('hidden');
                updateSliderFill(pageNum);
                positionTooltip();
            });

            pageSlider.addEventListener('change', (e) => {
                const pageNum = parseInt(e.target.value);
                pageFlip.turnToPage(pageNum);
                sliderTooltip.classList.add('hidden');
            });

            // Hide tooltip when pointer leaves
            pageSlider.addEventListener('pointerup', () => {
                setTimeout(() => sliderTooltip.classList.add('hidden'), 300);
            });

            // Page input: jump to page on Enter or blur
            pageInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    pageInput.blur();
                }
            });

            pageInput.addEventListener('blur', () => {
                let val = parseInt(pageInput.value);
                if (isNaN(val) || val < 0) val = 0;
                if (val > maxPage) val = maxPage;
                pageInput.value = val;
                pageFlip.turnToPage(val);
            });

            // Select all text on focus for easy editing
            pageInput.addEventListener('focus', () => {
                pageInput.select();
            });

            function positionTooltip() {
                const sliderRect = pageSlider.getBoundingClientRect();
                const val = parseInt(pageSlider.value);
                const min = parseInt(pageSlider.min);
                const max = parseInt(pageSlider.max);
                const range = max - min;
                const percent = range > 0 ? (val - min) / range : 0;
                // Account for thumb width (24px)
                const thumbOffset = 12;
                const trackWidth = sliderRect.width - 24;
                const left = thumbOffset + percent * trackWidth;
                sliderTooltip.style.left = left + 'px';
            }

            btnFullscreen.addEventListener('click', toggleFullscreen);
            // Also enable header and floating exit buttons
            const btnFullscreenHeader = document.getElementById('btn-fullscreen-header');
            if (btnFullscreenHeader) btnFullscreenHeader.addEventListener('click', toggleFullscreen);
            const btnFloatingExitFs = document.getElementById('btn-floating-exit-fs');
            if (btnFloatingExitFs) btnFloatingExitFs.addEventListener('click', toggleFullscreen);

            function toggleFullscreen() {
                const container = document.querySelector('.reader-container');
                const isInPseudoFS = container.classList.contains('pseudo-fullscreen');
                const isInNativeFS = !!(document.fullscreenElement || document.webkitFullscreenElement);
                
                if (!isInNativeFS && !isInPseudoFS) {
                    // Try native fullscreen first (desktop + Android Chrome)
                    const el = document.documentElement;
                    const requestFS = el.requestFullscreen || el.webkitRequestFullscreen || el.mozRequestFullScreen || el.msRequestFullscreen;
                    
                    if (requestFS) {
                        requestFS.call(el).then(() => {
                            updateFullscreenBtnUI(true);
                            setTimeout(() => { if (pageFlip) pageFlip.update(); }, 150);
                        }).catch(() => {
                            activatePseudoFullscreen(container);
                        });
                    } else {
                        // iOS iPhone or browsers without native API
                        activatePseudoFullscreen(container);
                    }
                } else {
                    if (isInNativeFS) {
                        const exitFS = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen || document.msExitFullscreen;
                        if (exitFS) exitFS.call(document);
                    }
                    if (isInPseudoFS) {
                        deactivatePseudoFullscreen(container);
                    }
                    updateFullscreenBtnUI(false);
                }
            }

            function activatePseudoFullscreen(container) {
                container.classList.add('pseudo-fullscreen');
                container.classList.add('is-fullscreen');
                document.body.style.overflow = 'hidden';
                window.scrollTo(0, 1);
                updateFullscreenBtnUI(true);
                try { navigator.wakeLock?.request?.('screen').catch(() => {}); } catch(e) {}
                setTimeout(() => { if(pageFlip) pageFlip.update(); }, 150);
            }

            function deactivatePseudoFullscreen(container) {
                container.classList.remove('pseudo-fullscreen');
                container.classList.remove('is-fullscreen');
                document.body.style.overflow = '';
                updateFullscreenBtnUI(false);
                setTimeout(() => { if(pageFlip) pageFlip.update(); }, 150);
            }

            function handleFSChange() {
                const container = document.querySelector('.reader-container');
                const isFS = !!(document.fullscreenElement || document.webkitFullscreenElement);
                if (isFS) {
                    container.classList.add('is-fullscreen');
                    updateFullscreenBtnUI(true);
                } else {
                    if (!container.classList.contains('pseudo-fullscreen')) {
                        container.classList.remove('is-fullscreen');
                        updateFullscreenBtnUI(false);
                    }
                }
                
                setTimeout(() => {
                    if(pageFlip) pageFlip.update();
                }, 150);
            }

            function updateFullscreenBtnUI(isFullscreen) {
                const title = isFullscreen ? 'Sair do Ecrã Inteiro' : 'Ecrã Inteiro';
                
                if (btnFullscreen) {
                    btnFullscreen.title = title;
                    btnFullscreen.setAttribute('aria-label', title);
                }
                const btnHeader = document.getElementById('btn-fullscreen-header');
                if (btnHeader) {
                    const btn = btnHeader.querySelector('button');
                    if (btn) {
                        btn.title = title;
                        btn.setAttribute('aria-label', title);
                    }
                }
            }

            document.addEventListener('fullscreenchange', handleFSChange);
            document.addEventListener('webkitfullscreenchange', handleFSChange);

            window.addEventListener('resize', () => {
                if (pageFlip) pageFlip.update();
            });
            window.addEventListener('orientationchange', () => {
                setTimeout(() => { if (pageFlip) pageFlip.update(); }, 200);
            });

            // Turn to initial page if specified in URL
            if (initialPage > 0) {
                pageFlip.turnToPage(initialPage);
            }

            // Initial render
            preload(initialPage);
            updateUI(initialPage);

            loadingOverlay.style.opacity = '0';
            setTimeout(() => loadingOverlay.style.display = 'none', 500);

        } catch (error) {
            console.error('Error loading reader:', error);
            alert('Erro ao carregar o livro: ' + error.message);
        }
    }

    const renderedPages = new Set();
    async function renderPage(num) {
        if (!pdfDoc) return;
        const maxPage = pdfDoc.numPages - 1;
        if (num < 0 || num > maxPage || renderedPages.has(num)) return;
        renderedPages.add(num);

        const canvas = document.getElementById(`canvas-page-${num}`);
        if (!canvas) return;

        const page = await pdfDoc.getPage(num + 1);
        const viewport = page.getViewport({ scale: 2 }); // Better quality
        const context = canvas.getContext('2d');
        canvas.height = viewport.height;
        canvas.width = viewport.width;

        await page.render({ canvasContext: context, viewport: viewport }).promise;

        // Load Links / Annotations
        try {
            const annotations = await page.getAnnotations();
            const pageContent = canvas.parentElement;
            
            const linksContainer = document.createElement('div');
            linksContainer.className = 'annotation-layer';
            linksContainer.style.position = 'absolute';
            linksContainer.style.top = '0';
            linksContainer.style.left = '0';
            linksContainer.style.width = '100%';
            linksContainer.style.height = '100%';
            linksContainer.style.pointerEvents = 'none';

            for (const anno of annotations) {
                if (anno.subtype !== 'Link') continue;
                // Skip annotations that have neither url nor dest
                if (!anno.url && !anno.dest) continue;

                const [x1, y1, x2, y2] = viewport.convertToViewportRectangle(anno.rect);
                const top = Math.min(y1, y2);
                const left = Math.min(x1, x2);
                const width = Math.abs(x2 - x1);
                const height = Math.abs(y2 - y1);

                const linkEl = document.createElement('a');
                linkEl.style.position = 'absolute';
                linkEl.style.left = `${(left / viewport.width) * 100}%`;
                linkEl.style.top = `${(top / viewport.height) * 100}%`;
                linkEl.style.width = `${(width / viewport.width) * 100}%`;
                linkEl.style.height = `${(height / viewport.height) * 100}%`;
                linkEl.style.cursor = 'pointer';
                linkEl.style.pointerEvents = 'auto';
                linkEl.style.zIndex = '10';

                if (anno.dest) {
                    // Link interno do PDF (usado pelo Índice)
                    let targetPageNum = null;

                    try {
                        if (typeof anno.dest === 'string') {
                            // Named destination - resolver via PDF
                            const dest = await pdfDoc.getDestination(anno.dest);
                            if (dest) {
                                const pageIndex = await pdfDoc.getPageIndex(dest[0]);
                                targetPageNum = pageIndex;
                            }
                        } else if (Array.isArray(anno.dest)) {
                            // Explicit destination array: [pageRef, ...]
                            const pageIndex = await pdfDoc.getPageIndex(anno.dest[0]);
                            targetPageNum = pageIndex;
                        }
                    } catch (e) {
                        console.warn('Could not resolve internal link destination:', e);
                    }

                    if (targetPageNum !== null) {
                        linkEl.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                            pageFlip.turnToPage(targetPageNum);
                        });
                    }
                } else if (anno.url) {
                    try {
                        const aUrl = new URL(anno.url, window.location.origin);
                        const mParam = aUrl.searchParams.get('m');
                        
                        if (mParam) {
                            // Link para Media (Interceptar)
                            linkEl.addEventListener('click', (e) => {
                                e.preventDefault();
                                e.stopPropagation();
                                openItem(parseInt(mParam));
                            });
                        } else {
                            // Link normal
                            linkEl.href = anno.url;
                            linkEl.target = '_blank';
                            linkEl.addEventListener('click', (e) => e.stopPropagation());
                        }
                    } catch (e) {
                        // URL Invalida
                    }
                }

                linksContainer.appendChild(linkEl);
            }
            pageContent.appendChild(linksContainer);
        } catch(e) { console.error("Could not load annotations", e); }
    }

    function updateSliderFill(current) {
        if (!pdfDoc) return;
        const maxPage = pdfDoc.numPages - 1;
        if (maxPage <= 0) return;
        
        const percent = (current / maxPage) * 100;
        
        // Precise calculation: thumb moves from 12px to (100% - 12px)
        // Its center aligns with the gradient stop.
        // Formula: stop = 12px + (percent/100) * (100% - 24px)
        const stop = `calc(12px + (${percent} / 100) * (100% - 24px))`;
        
        pageSlider.style.background = `linear-gradient(to right, var(--reader-accent) 0%, var(--reader-accent) ${stop}, rgba(255,255,255,0.1) ${stop}, rgba(255,255,255,0.1) 100%)`;
    }

    function updateUI(current) {
        if (!pdfDoc) return;
        const totalPages = pdfDoc.numPages;
        const maxPage = totalPages - 1;
        const orientation = pageFlip.getOrientation();
        
        let displayPages = "";
        let visiblePages = [current];

        if (current === 0) {
            displayPages = "0";
        } else if (current === maxPage && totalPages % 2 === 0) {
            displayPages = `${maxPage}`;
        } else {
            if (orientation === 'landscape') {
                const left = (current % 2 === 1) ? current : (current - 1);
                const right = left + 1;
                if (right <= maxPage) {
                    displayPages = `${left}-${right}`;
                    visiblePages = [left, right];
                } else {
                    displayPages = `${left}`;
                    visiblePages = [left];
                }
            } else {
                displayPages = `${current}`;
            }
        }
        
        pageCounter.textContent = `${displayPages} / ${maxPage}`;
        
        // Update page input to current page
        if (document.activeElement !== pageInput) {
            pageInput.value = current;
        }
        
        const sliderVal = parseInt(pageSlider.value);
        if (!visiblePages.includes(sliderVal)) {
            pageSlider.value = current;
        }
        updateSliderFill(parseInt(pageSlider.value));
    }

    // Modal Logic
    let currentAlbumTracks = [];
    const playerModal = document.getElementById('playerModal');
    const playerContainer = document.getElementById('playerContainer');
    const albumTrackList = document.getElementById('albumTrackList');

    function playMedia(filename, type, cover, startTime = 0) {
        const src = filename.startsWith('http') || filename.startsWith('/') ? filename : `/livro_media/${filename}`;
        let html = '';
        if (type === 'video') {
            html = `<video id="activePlayer" src="${src}" controls autoplay playsinline style="width:100%;height:100%;object-fit:contain;"></video>`;
        } else if (type === 'website') {
            html = `<iframe src="${src}" style="width:100%; height:100%; border:none; background:#fff; border-radius:8px;"></iframe>`;
        } else {
            if (cover) {
                html = `
                    <div class="audio-wrapper" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;">
                        <img src="${cover}" class="audio-cover" style="max-height:60vh;max-width:100%;object-fit:contain;margin-bottom:20px;" alt="Cover" />
                        <audio id="activePlayer" src="${src}" controls autoplay style="width:80%;max-width:600px;"></audio>
                    </div>`;
            } else {
                html = `
                    <div class="audio-wrapper" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;">
                        <div class="audio-placeholder" style="font-size:5rem;color:rgba(255,255,255,0.2);margin-bottom:20px;">🎵</div>
                        <audio id="activePlayer" src="${src}" controls autoplay style="width:80%;max-width:600px;"></audio>
                    </div>`;
            }
        }
        playerContainer.innerHTML = html;
        const player = document.getElementById('activePlayer');
        if (player) {
            player.addEventListener('play', () => { window.isMediaPlaying = true; });
            player.addEventListener('pause', () => { window.isMediaPlaying = false; });
            player.addEventListener('ended', handleMediaEnded);

            function executePlay() {
                const playPromise = player.play();
                if (playPromise !== undefined) {
                    playPromise.catch(err => {
                        console.warn('Playback waiting for interaction:', err);
                        // If unmuted autoplay blocked, play on very first user interaction
                        const onUserInteract = () => {
                            player.play().catch(() => {});
                            window.removeEventListener('click', onUserInteract);
                            window.removeEventListener('touchstart', onUserInteract);
                            window.removeEventListener('keydown', onUserInteract);
                        };
                        window.addEventListener('click', onUserInteract, { once: true });
                        window.addEventListener('touchstart', onUserInteract, { once: true });
                        window.addEventListener('keydown', onUserInteract, { once: true });
                    });
                }
            }

            if (startTime > 0) {
                let hasSeeked = false;
                const applyTimeAndPlay = () => {
                    if (!hasSeeked) {
                        try {
                            player.currentTime = startTime;
                            hasSeeked = true;
                        } catch(e) {}
                    }
                    executePlay();
                };

                if (player.readyState >= 1) {
                    applyTimeAndPlay();
                } else {
                    player.addEventListener('loadedmetadata', applyTimeAndPlay, { once: true });
                    player.addEventListener('canplay', applyTimeAndPlay, { once: true });
                }
                player.addEventListener('seeked', executePlay, { once: true });

                setTimeout(() => {
                    if (!hasSeeked) {
                        try { player.currentTime = startTime; } catch(e) {}
                    }
                    executePlay();
                }, 300);
            } else {
                if (player.readyState >= 2) {
                    executePlay();
                } else {
                    player.addEventListener('canplay', executePlay, { once: true });
                }
                setTimeout(executePlay, 100);
            }
        }
    }

    function handleMediaEnded() {
        if (currentAlbumTracks && currentAlbumTracks.length > 0) {
            const currentAudio = document.getElementById('activePlayer').src;
            const currentIdx = currentAlbumTracks.findIndex(t => currentAudio.includes(t.filename.split('/').pop()));
            if (currentIdx !== -1 && currentIdx < currentAlbumTracks.length - 1) {
                playAlbumTrack(currentAlbumTracks[currentIdx + 1], currentIdx + 1);
            }
        }
    }

    function playAlbumTrack(track, index, startTime = 0) {
        const tracks = albumTrackList.querySelectorAll('.track-item');
        tracks.forEach(t => t.classList.remove('active'));
        if(tracks[index]) tracks[index].classList.add('active');
        playMedia(track.filename, track.type, track.cover, startTime);
    }

    function openItem(id, trackIndex = 0, startTime = 0, autoMinimize = false) {
        if(!window.MIDIA_DATA) return;
        const item = window.MIDIA_DATA.find(m => m.id == id);
        if(!item) return;
        
        document.getElementById('modalTitle').textContent = item.title;
        document.getElementById('modalNumber').textContent = `#${id}`;
        
        albumTrackList.classList.add('hidden');
        playerContainer.innerHTML = '';
        currentAlbumTracks = [];
        
        if (item.type === 'album') {
            currentAlbumTracks = item.tracks;
            albumTrackList.classList.remove('hidden');
            albumTrackList.innerHTML = item.tracks.map((track, idx) => `
                <div class="track-item ${idx === trackIndex ? 'active' : ''}" data-idx="${idx}" style="cursor:pointer;padding:8px 12px;margin-bottom:4px;background:rgba(255,255,255,0.05);border-radius:4px;">
                    <span style="font-size:0.9rem;margin-right:8px;">${track.type === 'video' ? '📺' : track.type === 'website' ? '🌐' : '🎵'}</span>
                    <span style="font-size:0.85rem;">${track.title}</span>
                </div>
            `).join('');
            
            const trackElements = albumTrackList.querySelectorAll('.track-item');
            trackElements.forEach(el => {
                el.addEventListener('click', () => {
                    const idx = parseInt(el.dataset.idx);
                    playAlbumTrack(currentAlbumTracks[idx], idx);
                });
            });

            const initialIdx = (trackIndex >= 0 && trackIndex < currentAlbumTracks.length) ? trackIndex : 0;
            if (currentAlbumTracks.length > 0) {
                playAlbumTrack(currentAlbumTracks[initialIdx], initialIdx, startTime);
            }
        } else {
            playMedia(item.filename, item.type, item.cover, startTime);
        }
        
        if (autoMinimize) {
            playerModal.classList.add('minimized');
            playerModal.style.removeProperty('left');
            playerModal.style.removeProperty('top');
            playerModal.style.bottom = '80px';
            playerModal.style.right = '40px';
        } else {
            playerModal.classList.remove('minimized');
            playerModal.style.removeProperty('left');
            playerModal.style.removeProperty('top');
            playerModal.style.removeProperty('bottom');
            playerModal.style.removeProperty('right');
        }

        playerModal.classList.remove('hidden');
    }

    function closePlayer() {
        playerModal.classList.add('hidden');
        playerModal.classList.remove('minimized');
        playerContainer.innerHTML = '';
        const player = document.getElementById('activePlayer');
        if (player) {
            player.pause();
            player.src = '';
        }
    }

    document.querySelector('.minimize-modal').addEventListener('click', () => {
        playerModal.classList.toggle('minimized');
        // Reset position when minimizing so it starts at default spot
        if (playerModal.classList.contains('minimized')) {
            playerModal.style.removeProperty('left');
            playerModal.style.removeProperty('top');
            playerModal.style.bottom = '80px';
            playerModal.style.right = '40px';
        } else {
            // Reset inline styles when maximizing
            playerModal.style.removeProperty('left');
            playerModal.style.removeProperty('top');
            playerModal.style.removeProperty('bottom');
            playerModal.style.removeProperty('right');
        }
    });

    // Drag support for minimized player
    let isDragging = false;
    let dragStartX, dragStartY, modalStartX, modalStartY;

    playerModal.addEventListener('mousedown', (e) => {
        if (!playerModal.classList.contains('minimized')) return;
        const dragOverlay = document.getElementById('dragOverlay');
        // Only drag from the overlay area
        if (e.target !== dragOverlay) return;

        isDragging = true;
        const rect = playerModal.getBoundingClientRect();
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        modalStartX = rect.left;
        modalStartY = rect.top;
        playerModal.style.cursor = 'grabbing';
        e.preventDefault();
    });

    document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - dragStartX;
        const dy = e.clientY - dragStartY;
        // Switch from bottom/right positioning to top/left for free movement
        playerModal.style.bottom = 'auto';
        playerModal.style.right = 'auto';
        playerModal.style.left = (modalStartX + dx) + 'px';
        playerModal.style.top = (modalStartY + dy) + 'px';
    });

    document.addEventListener('mouseup', () => {
        if (isDragging) {
            isDragging = false;
            playerModal.style.cursor = '';
        }
    });

    // Touch support for mobile drag
    playerModal.addEventListener('touchstart', (e) => {
        if (!playerModal.classList.contains('minimized')) return;
        const dragOverlay = document.getElementById('dragOverlay');
        if (e.target !== dragOverlay) return;

        isDragging = true;
        const rect = playerModal.getBoundingClientRect();
        const touch = e.touches[0];
        dragStartX = touch.clientX;
        dragStartY = touch.clientY;
        modalStartX = rect.left;
        modalStartY = rect.top;
    }, { passive: true });

    document.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        const touch = e.touches[0];
        const dx = touch.clientX - dragStartX;
        const dy = touch.clientY - dragStartY;
        playerModal.style.bottom = 'auto';
        playerModal.style.right = 'auto';
        playerModal.style.left = (modalStartX + dx) + 'px';
        playerModal.style.top = (modalStartY + dy) + 'px';
    }, { passive: true });

    document.addEventListener('touchend', () => {
        isDragging = false;
    });

    document.querySelector('.close-modal').addEventListener('click', closePlayer);
    document.querySelector('.modal-overlay').addEventListener('click', () => {
        if (!playerModal.classList.contains('minimized')) {
            closePlayer();
        }
    });

    // Start immediate media playback without waiting for PDF
    (function checkInitialMedia() {
        const params = new URLSearchParams(window.location.search);
        const mParam = params.get('m');
        if (mParam) {
            const mId = parseInt(mParam);
            if (!isNaN(mId)) {
                const trParam = params.get('tr');
                const tParam = params.get('t');
                const trIdx = trParam ? parseInt(trParam) : 0;
                const sTime = tParam ? parseFloat(tParam) : 0;
                // Open and play in mini-player immediately!
                setTimeout(() => {
                    openItem(mId, trIdx, sTime, true);
                }, 50);
            }
        }
    })();

    // Start
    window.addEventListener('DOMContentLoaded', initReader);
</script>

<style>
