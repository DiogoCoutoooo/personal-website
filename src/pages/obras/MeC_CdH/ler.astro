---
import Layout from '../../../layouts/Layout.astro';
import midiaData from '../../../data/midia.json';
---

<Layout title="Leitor — Coluna de Harmonia, Madrugada em Clave" description="Leia uma amostra do livro Coluna de Harmonia, Madrugada em Clave.">
    <div class="reader-container">
        <!-- Header Controls -->
        <header class="reader-header">
            <div class="header-left">
                <a href="/obras/MeC_CdH" class="back-link">
                    <span class="icon">✕</span>
                    <span class="text">Sair do Leitor</span>
                </a>
            </div>
            <div class="header-center">
                <h1 class="book-title-mini">Coluna de Harmonia, Madrugada em Clave</h1>
            </div>
            <div class="header-right">
                <span id="page-counter">A carregar...</span>
            </div>
        </header>

        <!-- Main Reader Shell -->
        <div class="reader-shell">
            <button id="btn-prev" class="nav-btn prev" aria-label="Página Anterior">
                <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
            </button>
            
            <div class="book-bounds">
                <div id="book-canvas-container" class="book-canvas-container">
                    <div id="book" class="book">
                        <!-- Pages will be injected here -->
                    </div>
                </div>
            </div>

            <button id="btn-next" class="nav-btn next" aria-label="Próxima Página">
                <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
            </button>
        </div>

        <!-- Footer Controls -->
        <footer class="reader-footer">
            <div class="footer-controls">
                <div class="page-slider-container">
                    <span class="slider-label">1</span>
                    <input type="range" id="page-slider" min="1" max="1" value="1" step="1">
                    <span id="slider-total-label" class="slider-label">...</span>
                </div>
                <div class="footer-right">
                    <button id="btn-fullscreen" class="footer-btn" title="Ecrã Inteiro">
                        <svg viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                    </button>
                </div>
            </div>
        </footer>

        <!-- Loading Overlay -->
        <div id="loading-overlay" class="loading-overlay">
            <div class="loader"></div>
            <p>A preparar a sua leitura...</p>
        </div>

        <!-- Player Modal -->
        <div id="playerModal" class="player-modal hidden">
            <div class="modal-overlay"></div>
            
            <div class="modal-content">
                <button class="minimize-modal" aria-label="Minimizar/Maximizar">
                    <svg class="icon-min" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <svg class="icon-max" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
                </button>
                <button class="close-modal" aria-label="Fechar">&times;</button>
                <div id="playerContainer" class="player-container">
                    <!-- Player or Album List will be injected here -->
                </div>
                <div id="dragOverlay" class="drag-overlay"></div>
                <div class="modal-info">
                    <div class="modal-header-info">
                        <span id="modalNumber"></span>
                        <h2 id="modalTitle"></h2>
                    </div>
                    <div id="albumTrackList" class="album-track-list hidden">
                        <!-- Track list for albums -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script is:inline define:vars={{ midiaData }}>
    window.MIDIA_DATA = midiaData;
</script>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>
<script is:inline src="https://unpkg.com/page-flip/dist/js/page-flip.browser.js"></script>

<script is:inline>
    // Configuration
    const PDF_PATH = 'https://media.antonioabrantes.com/MAD_CH_6023-25_LIVRO_AS_Tamanho_Envelope%20C5_TRABALHO_PC_Final%20.pdf';
    let pdfDoc = null;
    let pageFlip = null;
    
    const loadingOverlay = document.getElementById('loading-overlay');
    const bookContainer = document.getElementById('book');
    const pageCounter = document.getElementById('page-counter');
    const pageSlider = document.getElementById('page-slider');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const btnFullscreen = document.getElementById('btn-fullscreen');

    // Initialize PDF.js
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';

    async function initReader() {
        try {
            // Load PDF
            pdfDoc = await pdfjsLib.getDocument(PDF_PATH).promise;
            const totalPages = pdfDoc.numPages;
            
            pageSlider.max = totalPages;
            
            // We need to determine the aspect ratio from the first page
            const firstPage = await pdfDoc.getPage(1);
            const vp = firstPage.getViewport({ scale: 1 });
            const pageAspectRatio = vp.width / vp.height;
            const baseHeight = 800;
            const baseWidth = baseHeight * pageAspectRatio;

            pageFlip = new St.PageFlip(bookContainer, {
                width: baseWidth,
                height: baseHeight,
                size: "stretch",
                minWidth: 200,
                maxWidth: 2000,
                minHeight: 300,
                maxHeight: 2000,
                maxShadowOpacity: 0.5,
                showCover: true,
                mobileScrollSupport: false
            });

            // Create page placeholders
            for (let i = 1; i <= totalPages; i++) {
                const pageEl = document.createElement('div');
                pageEl.className = 'page';
                pageEl.innerHTML = `
                    <div class="page-content">
                        <canvas id="canvas-page-${i}"></canvas>
                    </div>
                `;
                bookContainer.appendChild(pageEl);
            }

            pageFlip.loadFromHTML(document.querySelectorAll('.page'));
            document.getElementById('slider-total-label').textContent = totalPages;

            function preload(current) {
                for (let i = current - 4; i <= current + 4; i++) {
                    renderPage(i);
                }
            }

            // Initial render of first few pages
            preload(1);

            // Events
            btnPrev.addEventListener('click', () => pageFlip.flipPrev());
            btnNext.addEventListener('click', () => pageFlip.flipNext());

            pageFlip.on('changeState', (e) => {
                if (e.data === 'user_fold') {
                    const currentPage = pageFlip.getCurrentPageIndex() + 1;
                    preload(currentPage);
                }
            });

            pageFlip.on('flip', (e) => {
                const currentPage = e.data + 1;
                updateUI(currentPage);
                preload(currentPage);
            });

            pageSlider.addEventListener('input', (e) => {
                const pageNum = parseInt(e.target.value);
                pageFlip.turnToPage(pageNum - 1);
                updateSliderFill(pageNum);
            });

            btnFullscreen.addEventListener('click', () => {
                if (!document.fullscreenElement) {
                    document.documentElement.requestFullscreen();
                } else {
                    if (document.exitFullscreen) {
                        document.exitFullscreen();
                    }
                }
            });

            document.addEventListener('fullscreenchange', () => {
                const container = document.querySelector('.reader-container');
                if (document.fullscreenElement) {
                    container.classList.add('is-fullscreen');
                } else {
                    container.classList.remove('is-fullscreen');
                }
                
                // Allow page flip to recalculate sizes immediately
                setTimeout(() => {
                    if(pageFlip) pageFlip.update();
                }, 100);
            });

            loadingOverlay.style.opacity = '0';
            setTimeout(() => loadingOverlay.style.display = 'none', 500);
            updateUI(1);

        } catch (error) {
            console.error('Error loading reader:', error);
            alert('Erro ao carregar o livro: ' + error.message);
        }
    }

    const renderedPages = new Set();
    async function renderPage(num) {
        if (num < 1 || num > pdfDoc.numPages || renderedPages.has(num)) return;
        renderedPages.add(num);

        const canvas = document.getElementById(`canvas-page-${num}`);
        if (!canvas) return;

        const page = await pdfDoc.getPage(num);
        const viewport = page.getViewport({ scale: 2 }); // Better quality
        const context = canvas.getContext('2d');
        canvas.height = viewport.height;
        canvas.width = viewport.width;

        await page.render({ canvasContext: context, viewport: viewport }).promise;

        // Load Links / Annotations
        try {
            const annotations = await page.getAnnotations();
            const pageContent = canvas.parentElement;
            
            const linksContainer = document.createElement('div');
            linksContainer.className = 'annotation-layer';
            linksContainer.style.position = 'absolute';
            linksContainer.style.top = '0';
            linksContainer.style.left = '0';
            linksContainer.style.width = '100%';
            linksContainer.style.height = '100%';
            linksContainer.style.pointerEvents = 'none';

            for (const anno of annotations) {
                if (anno.subtype !== 'Link') continue;
                // Skip annotations that have neither url nor dest
                if (!anno.url && !anno.dest) continue;

                const [x1, y1, x2, y2] = viewport.convertToViewportRectangle(anno.rect);
                const top = Math.min(y1, y2);
                const left = Math.min(x1, x2);
                const width = Math.abs(x2 - x1);
                const height = Math.abs(y2 - y1);

                const linkEl = document.createElement('a');
                linkEl.style.position = 'absolute';
                linkEl.style.left = `${(left / viewport.width) * 100}%`;
                linkEl.style.top = `${(top / viewport.height) * 100}%`;
                linkEl.style.width = `${(width / viewport.width) * 100}%`;
                linkEl.style.height = `${(height / viewport.height) * 100}%`;
                linkEl.style.cursor = 'pointer';
                linkEl.style.pointerEvents = 'auto';
                linkEl.style.zIndex = '10';

                if (anno.dest) {
                    // Link interno do PDF (usado pelo Índice)
                    let targetPageNum = null;

                    try {
                        if (typeof anno.dest === 'string') {
                            // Named destination - resolver via PDF
                            const dest = await pdfDoc.getDestination(anno.dest);
                            if (dest) {
                                const pageIndex = await pdfDoc.getPageIndex(dest[0]);
                                targetPageNum = pageIndex + 1;
                            }
                        } else if (Array.isArray(anno.dest)) {
                            // Explicit destination array: [pageRef, ...]
                            const pageIndex = await pdfDoc.getPageIndex(anno.dest[0]);
                            targetPageNum = pageIndex + 1;
                        }
                    } catch (e) {
                        console.warn('Could not resolve internal link destination:', e);
                    }

                    if (targetPageNum !== null) {
                        linkEl.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                            pageFlip.turnToPage(targetPageNum - 1);
                        });
                    }
                } else if (anno.url) {
                    try {
                        const aUrl = new URL(anno.url, window.location.origin);
                        const mParam = aUrl.searchParams.get('m');
                        
                        if (mParam) {
                            // Link para Media (Interceptar)
                            linkEl.addEventListener('click', (e) => {
                                e.preventDefault();
                                e.stopPropagation();
                                openItem(parseInt(mParam));
                            });
                        } else {
                            // Link normal
                            linkEl.href = anno.url;
                            linkEl.target = '_blank';
                            linkEl.addEventListener('click', (e) => e.stopPropagation());
                        }
                    } catch (e) {
                        // URL Invalida
                    }
                }

                linksContainer.appendChild(linkEl);
            }
            pageContent.appendChild(linksContainer);
        } catch(e) { console.error("Could not load annotations", e); }
    }

    function updateSliderFill(current) {
        if (!pdfDoc) return;
        const total = pdfDoc.numPages;
        if (total <= 1) return;
        
        const percent = ((current - 1) / (total - 1)) * 100;
        
        // Precise calculation: thumb moves from 12px to (100% - 12px)
        // Its center aligns with the gradient stop.
        // Formula: stop = 12px + (percent/100) * (100% - 24px)
        const stop = `calc(12px + (${percent} / 100) * (100% - 24px))`;
        
        pageSlider.style.background = `linear-gradient(to right, var(--reader-accent) 0%, var(--reader-accent) ${stop}, rgba(255,255,255,0.1) ${stop}, rgba(255,255,255,0.1) 100%)`;
    }

    function updateUI(current) {
        if (!pdfDoc) return;
        const total = pdfDoc.numPages;
        const orientation = pageFlip.getOrientation();
        
        let displayPages = "";
        let visiblePages = [current];

        if (current === 1) {
            displayPages = "1";
        } else if (current === total && total % 2 === 0) {
            displayPages = total;
        } else {
            if (orientation === 'landscape') {
                const next = current + 1;
                displayPages = next <= total ? `${current}-${next}` : `${current}`;
                if (next <= total) visiblePages.push(next);
            } else {
                displayPages = `${current}`;
            }
        }
        
        pageCounter.textContent = `${displayPages} / ${total}`;
        
        const sliderVal = parseInt(pageSlider.value);
        if (!visiblePages.includes(sliderVal)) {
            pageSlider.value = current;
        }
        updateSliderFill(parseInt(pageSlider.value));
    }

    // Modal Logic
    let currentAlbumTracks = [];
    const playerModal = document.getElementById('playerModal');
    const playerContainer = document.getElementById('playerContainer');
    const albumTrackList = document.getElementById('albumTrackList');

    function playMedia(filename, type, cover) {
        const src = filename.startsWith('http') ? filename : `/livro_media/${filename}`;
        let html = '';
        if (type === 'video') {
            html = `<video id="activePlayer" src="${src}" controls autoplay playsinline style="width:100%;height:100%;object-fit:contain;"></video>`;
        } else {
            if (cover) {
                html = `
                    <div class="audio-wrapper" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;">
                        <img src="${cover}" class="audio-cover" style="max-height:60vh;max-width:100%;object-fit:contain;margin-bottom:20px;" alt="Cover" />
                        <audio id="activePlayer" src="${src}" controls autoplay style="width:80%;max-width:600px;"></audio>
                    </div>`;
            } else {
                html = `
                    <div class="audio-wrapper" style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;">
                        <div class="audio-placeholder" style="font-size:5rem;color:rgba(255,255,255,0.2);margin-bottom:20px;">🎵</div>
                        <audio id="activePlayer" src="${src}" controls autoplay style="width:80%;max-width:600px;"></audio>
                    </div>`;
            }
        }
        playerContainer.innerHTML = html;
        const player = document.getElementById('activePlayer');
        if(player) {
            player.addEventListener('play', () => { window.isMediaPlaying = true; });
            player.addEventListener('pause', () => { window.isMediaPlaying = false; });
            player.addEventListener('ended', handleMediaEnded);
        }
    }

    function handleMediaEnded() {
        if (currentAlbumTracks && currentAlbumTracks.length > 0) {
            const currentAudio = document.getElementById('activePlayer').src;
            const currentIdx = currentAlbumTracks.findIndex(t => currentAudio.includes(t.filename.split('/').pop()));
            if (currentIdx !== -1 && currentIdx < currentAlbumTracks.length - 1) {
                playAlbumTrack(currentAlbumTracks[currentIdx + 1], currentIdx + 1);
            }
        }
    }

    function playAlbumTrack(track, index) {
        const tracks = albumTrackList.querySelectorAll('.track-item');
        tracks.forEach(t => t.classList.remove('active'));
        if(tracks[index]) tracks[index].classList.add('active');
        playMedia(track.filename, track.type, track.cover);
    }

    function openItem(id) {
        if(!window.MIDIA_DATA) return;
        const item = window.MIDIA_DATA.find(m => m.id == id);
        if(!item) return;
        
        document.getElementById('modalTitle').textContent = item.title;
        document.getElementById('modalNumber').textContent = `#${id}`;
        
        albumTrackList.classList.add('hidden');
        playerContainer.innerHTML = '';
        currentAlbumTracks = [];
        
        if (item.type === 'album') {
            currentAlbumTracks = item.tracks;
            albumTrackList.classList.remove('hidden');
            albumTrackList.innerHTML = item.tracks.map((track, idx) => `
                <div class="track-item" data-idx="${idx}" style="cursor:pointer;padding:8px 12px;margin-bottom:4px;background:rgba(255,255,255,0.05);border-radius:4px;">
                    <span style="font-size:0.9rem;margin-right:8px;">${track.type === 'video' ? '📺' : '🎵'}</span>
                    <span style="font-size:0.85rem;">${track.title}</span>
                </div>
            `).join('');
            
            const trackElements = albumTrackList.querySelectorAll('.track-item');
            trackElements.forEach(el => {
                el.addEventListener('click', () => {
                    const idx = parseInt(el.dataset.idx);
                    playAlbumTrack(currentAlbumTracks[idx], idx);
                });
            });

            if (currentAlbumTracks.length > 0) {
                playAlbumTrack(currentAlbumTracks[0], 0);
            }
        } else {
            playMedia(item.filename, item.type, item.cover);
        }
        
        playerModal.classList.remove('hidden');
    }

    function closePlayer() {
        playerModal.classList.add('hidden');
        playerModal.classList.remove('minimized');
        playerContainer.innerHTML = '';
        const player = document.getElementById('activePlayer');
        if (player) {
            player.pause();
            player.src = '';
        }
    }

    document.querySelector('.minimize-modal').addEventListener('click', () => {
        playerModal.classList.toggle('minimized');
        // Reset position when minimizing so it starts at default spot
        if (playerModal.classList.contains('minimized')) {
            playerModal.style.removeProperty('left');
            playerModal.style.removeProperty('top');
            playerModal.style.bottom = '80px';
            playerModal.style.right = '40px';
        } else {
            // Reset inline styles when maximizing
            playerModal.style.removeProperty('left');
            playerModal.style.removeProperty('top');
            playerModal.style.removeProperty('bottom');
            playerModal.style.removeProperty('right');
        }
    });

    // Drag support for minimized player
    let isDragging = false;
    let dragStartX, dragStartY, modalStartX, modalStartY;

    playerModal.addEventListener('mousedown', (e) => {
        if (!playerModal.classList.contains('minimized')) return;
        const dragOverlay = document.getElementById('dragOverlay');
        // Only drag from the overlay area
        if (e.target !== dragOverlay) return;

        isDragging = true;
        const rect = playerModal.getBoundingClientRect();
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        modalStartX = rect.left;
        modalStartY = rect.top;
        playerModal.style.cursor = 'grabbing';
        e.preventDefault();
    });

    document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dx = e.clientX - dragStartX;
        const dy = e.clientY - dragStartY;
        // Switch from bottom/right positioning to top/left for free movement
        playerModal.style.bottom = 'auto';
        playerModal.style.right = 'auto';
        playerModal.style.left = (modalStartX + dx) + 'px';
        playerModal.style.top = (modalStartY + dy) + 'px';
    });

    document.addEventListener('mouseup', () => {
        if (isDragging) {
            isDragging = false;
            playerModal.style.cursor = '';
        }
    });

    // Touch support for mobile drag
    playerModal.addEventListener('touchstart', (e) => {
        if (!playerModal.classList.contains('minimized')) return;
        const dragOverlay = document.getElementById('dragOverlay');
        if (e.target !== dragOverlay) return;

        isDragging = true;
        const rect = playerModal.getBoundingClientRect();
        const touch = e.touches[0];
        dragStartX = touch.clientX;
        dragStartY = touch.clientY;
        modalStartX = rect.left;
        modalStartY = rect.top;
    }, { passive: true });

    document.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        const touch = e.touches[0];
        const dx = touch.clientX - dragStartX;
        const dy = touch.clientY - dragStartY;
        playerModal.style.bottom = 'auto';
        playerModal.style.right = 'auto';
        playerModal.style.left = (modalStartX + dx) + 'px';
        playerModal.style.top = (modalStartY + dy) + 'px';
    }, { passive: true });

    document.addEventListener('touchend', () => {
        isDragging = false;
    });

    document.querySelector('.close-modal').addEventListener('click', closePlayer);
    document.querySelector('.modal-overlay').addEventListener('click', () => {
        if (!playerModal.classList.contains('minimized')) {
            closePlayer();
        }
    });

    // Start
    window.addEventListener('DOMContentLoaded', initReader);
</script>

<style>
    :root {
        --reader-bg: #1a1a1a;
        --reader-header-bg: #000000;
        --reader-footer-bg: rgba(0, 0, 0, 0.8);
        --reader-accent: #d4af37;
    }

    .reader-container {
        position: fixed;
        inset: 0;
        background: var(--reader-bg);
        color: #fff;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        font-family: 'Poppins', sans-serif;
    }

    /* Header */
    .reader-header {
        height: 60px;
        background: var(--reader-header-bg);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        z-index: 10;
    }

    .back-link {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #999;
        transition: color 0.3s;
    }

    .back-link:hover {
        color: #fff;
    }

    .book-title-mini {
        font-size: 1rem;
        font-weight: 400;
        margin: 0;
        color: #ddd;
    }

    #page-counter {
        font-size: 0.9rem;
        color: #999;
        font-variant-numeric: tabular-nums;
    }

    /* Shell */
    .reader-shell {
        flex: 1;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 100px; /* Increased padding to give more breathing room */
        background: radial-gradient(circle, #2a2a2a 0%, #1a1a1a 100%);
        min-height: 0;
        box-sizing: border-box;
    }

    .book-bounds {
        width: 100%;
        height: 100%;
        max-width: 65vw;
        max-height: 65vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .book-canvas-container {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .book {
        box-shadow: 0 0 100px rgba(0,0,0,0.8);
    }

    .page {
        background: white;
        overflow: hidden;
    }

    .page-content {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .page-content canvas {
        width: 100%;
        height: 100%;
        display: block;
    }

    .page-number-hint {
        position: absolute;
        bottom: 10px;
        right: 15px;
        font-size: 10px;
        color: #ccc;
        pointer-events: none;
    }

    /* Navigation */
    .nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 60px;
        height: 80px;
        background: rgba(0,0,0,0.3);
        border: none;
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.3s, transform 0.2s;
        border-radius: 8px;
        z-index: 5;
    }

    .nav-btn:hover {
        background: rgba(0,0,0,0.6);
        transform: translateY(-50%) scale(1.05);
    }

    .nav-btn svg {
        width: 40px;
        height: 40px;
        fill: currentColor;
    }

    .nav-btn.prev { left: 40px; }
    .nav-btn.next { right: 40px; }

    /* Footer */
    .reader-footer {
        height: 70px;
        background: var(--reader-footer-bg);
        backdrop-filter: blur(15px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 40px;
        border-top: 1px solid rgba(255,255,255,0.05);
        z-index: 10;
    }

